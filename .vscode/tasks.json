{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: TUI",
            "detail": "用 MinGW g++ 编译 TUI 版到 output/scheduler.exe",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1", "-Target", "tui"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build: Qt",
            "detail": "用 CMake + MinGW 编译 Qt 版到 build_qt/scheduler_qt.exe",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1", "-Target", "qt"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "build: all",
            "detail": "TUI + Qt 一起编译",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1", "-Target", "all"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "run: TUI",
            "type": "shell",
            "command": ".\\output\\scheduler.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "dependsOn": ["build: TUI"]
        },
        {
            "label": "run: GUI",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/run_gui.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
